# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly declare text files
*.sh text eol=lf
*.bats text eol=lf
*.bash text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf diff=markdown
*.toml text eol=lf

.gitattributes text linguist-language=gitattributes exports-ignore
.gitignore text exports-ignore
